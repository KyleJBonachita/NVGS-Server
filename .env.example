# Docker publishes HTTPS only on this host address. Keep 127.0.0.1 until a
# deliberate authorized manual or temporary dynamic LAN pilot.
SERVER_BIND_IP=127.0.0.1

# "manual" keeps the configured address. For an authorized temporary DHCP
# pilot, enable "dynamic" once with:
#   ./scripts/refresh-dynamic-lan.sh ETHERNET_INTERFACE
NVGS_LAN_MODE=manual
# Preferred hosting interface. An explicit choice remains selected while it
# has an IPv4 address; startup falls back safely without forgetting it.
NVGS_LAN_INTERFACE=
# Maintained automatically; do not edit by hand.
NVGS_ACTIVE_LAN_INTERFACE=
# Optional resolvable name, for example ticketing-system.local. Dynamic mode
# keeps this link stable while SERVER_BIND_IP follows DHCP.
NVGS_LAN_SERVER_NAME=

# "unless-stopped" is for a permanently running server. The optional desktop
# controller changes this to "no" so NVGS runs only while its window is open.
NVGS_HOST_MODE=always_on
NVGS_RESTART_POLICY=unless-stopped

# DownloadServer is an optional profile started from NVGS Server Hub. Binding
# to 0.0.0.0 makes it available on every active Ethernet and Wi-Fi address.
# Use it only on a trusted private LAN; never forward this port from a router.
DOWNLOAD_SERVER_BIND_IP=0.0.0.0
DOWNLOAD_SERVER_PORT=8080
DOWNLOAD_SERVER_NAME=download-system.local

# Caddy creates a certificate for this name or IP. For a LAN pilot this can be
# the same IP as SERVER_BIND_IP. An internal DNS name is better when available.
SERVER_ADDRESS=localhost
# Caddy must recognize every browser address. LAN helpers maintain this value.
CADDY_SITE_ADDRESSES="localhost https://127.0.0.1"

POSTGRES_DB=nvgs_ticketing
POSTGRES_USER=nvgs_app

DJANGO_ENVIRONMENT=production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
DJANGO_TIME_ZONE=Asia/Singapore
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
ALLOWED_EMAIL_DOMAINS=nvidia.com
GUNICORN_WORKERS=3

# Optional standalone domain-restricted Google Apps Script login bridge.
# Keep disabled until the bridge is deployed, configured, and reviewed.
APPSCRIPT_SSO_ENABLED=false
APPSCRIPT_SSO_URL=
APPSCRIPT_SSO_ISSUER=nvgs-appscript
APPSCRIPT_SSO_AUDIENCE=nvgs-server
APPSCRIPT_SSO_AUTO_CREATE_USERS=true
APPSCRIPT_SSO_SUCCESS_REDIRECT=/tickets/

# Ticket notifications: disabled, webhook, email, or appscript.
TICKET_NOTIFICATION_DELIVERY_MODE=disabled
TICKET_NOTIFICATION_PUBLIC_BASE_URL=https://localhost

# Optional approved Teams/Slack/generic webhook.
# Store the real URL only in secrets/ticket_notification_webhook on Ubuntu.
TICKET_NOTIFICATION_WEBHOOK_URL=

# Signed standalone Apps Script relay. The URL is safe in .env; the shared
# secret lives only in secrets/appscript_notification_secret.
TICKET_NOTIFICATION_APPSCRIPT_URL=

# Email mode preserves the JSON email format used by the existing
# Gmail -> Power Automate -> Teams flow. Use only an approved SMTP relay or
# service account; never place a personal mailbox password in .env.
TICKET_NOTIFICATION_EMAIL_TO=
TICKET_NOTIFICATION_EMAIL_TARGET_NAME=OpsGroupChat
TICKET_NOTIFICATION_TEAMS_CHAT_ID=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
