# Docker publishes HTTPS only on this host address. Keep 127.0.0.1 until a
# deliberate authorized manual or temporary dynamic LAN pilot.
SERVER_BIND_IP=127.0.0.1

# "manual" keeps the configured address. For an authorized temporary DHCP
# pilot, enable "dynamic" once with:
#   ./scripts/refresh-dynamic-lan.sh ETHERNET_INTERFACE
NVGS_LAN_MODE=manual
NVGS_LAN_INTERFACE=

# "unless-stopped" is for a permanently running server. The optional desktop
# controller changes this to "no" so NVGS runs only while its window is open.
NVGS_HOST_MODE=always_on
NVGS_RESTART_POLICY=unless-stopped

# Caddy creates a certificate for this name or IP. For a LAN pilot this can be
# the same IP as SERVER_BIND_IP. An internal DNS name is better when available.
SERVER_ADDRESS=localhost

POSTGRES_DB=nvgs_ticketing
POSTGRES_USER=nvgs_app

DJANGO_ENVIRONMENT=production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
DJANGO_TIME_ZONE=Asia/Singapore
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
ALLOWED_EMAIL_DOMAINS=nvidia.com
GUNICORN_WORKERS=3

# Optional standalone domain-restricted Google Apps Script login bridge.
# Keep disabled until the bridge is deployed, configured, and reviewed.
APPSCRIPT_SSO_ENABLED=false
APPSCRIPT_SSO_URL=
APPSCRIPT_SSO_ISSUER=nvgs-appscript
APPSCRIPT_SSO_AUDIENCE=nvgs-server
APPSCRIPT_SSO_AUTO_CREATE_USERS=true
APPSCRIPT_SSO_SUCCESS_REDIRECT=/tickets/

# Optional approved Teams/Slack/generic webhook for ticket activity.
# Store the real URL only in secrets/ticket_notification_webhook on Ubuntu.
TICKET_NOTIFICATION_WEBHOOK_URL=
