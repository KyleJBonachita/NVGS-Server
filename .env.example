# Docker publishes HTTPS only on this host address. Keep 127.0.0.1 until the
# server has an approved static address or DHCP reservation.
SERVER_BIND_IP=127.0.0.1

# "unless-stopped" is for a permanently running server. The optional desktop
# controller changes this to "no" so NVGS runs only while its window is open.
NVGS_HOST_MODE=always_on
NVGS_RESTART_POLICY=unless-stopped

# Caddy creates a certificate for this name or IP. For a LAN pilot this can be
# the same IP as SERVER_BIND_IP. An internal DNS name is better when available.
SERVER_ADDRESS=localhost

POSTGRES_DB=nvgs_ticketing
POSTGRES_USER=nvgs_app

DJANGO_ENVIRONMENT=production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
DJANGO_TIME_ZONE=Asia/Singapore
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
ALLOWED_EMAIL_DOMAINS=nvidia.com
GUNICORN_WORKERS=3
