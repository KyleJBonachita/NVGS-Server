PORT=3000
HOST=0.0.0.0

# Required only for knowledge-library administration when running outside
# Docker. Use a long random value and never commit the real token.
GERY_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
GERY_MAX_UPLOAD_BYTES=26214400
GERY_ALLOW_INSECURE_ADMIN=false

# The default chat path uses saved answers and never calls a model.
GERY_INGESTION_AI_ENABLED=false
GERY_ALLOW_LIVE_AI=false

# Optional OpenAI-compatible endpoint, such as a local LM Studio server.
GERY_AI_BASE_URL=http://127.0.0.1:1234
GERY_AI_MODEL=meta-llama-3.1-8b-instruct
GERY_AI_API_KEY=
GERY_ALLOWED_ORIGINS=

MAX_CONTEXT_SECTIONS=5
MAX_CONTEXT_CHARS=8000
