{
	admin off
	default_sni {$SERVER_BIND_IP:127.0.0.1}
	skip_install_trust
}

(nvgs_common) {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	log {
		output stdout
		format json
	}
}

{$CADDY_SITE_ADDRESSES:localhost} {
	tls internal
	import nvgs_common

	@database_admin path /admin /admin/*
	respond @database_admin "Database administration is available only on the Ubuntu server." 403

	reverse_proxy app:8000
}

https://localhost:8443 {
	tls internal
	import nvgs_common
	reverse_proxy app:8000
}
