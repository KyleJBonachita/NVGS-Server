[Unit]
Description=NVGS external availability watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/nvgs-remote-watch.env
ExecStart=/usr/bin/python3 /usr/local/lib/nvgs/nvgs_remote_watch.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
