# The setup script creates /etc/nvgs-monitor.env from these settings.
NVGS_SERVER_NAME=NVGS-Server
NVGS_NETWORK_INTERFACE=auto
NVGS_APP_HEALTH_URL=https://localhost/api/health/
NVGS_CA_FILE=/path/to/NVGS-Server/nvgs-local-ca.crt
NVGS_CONNECTIVITY_URL=https://connectivity-check.ubuntu.com/
NVGS_CHECK_INTERVAL_SECONDS=5
NVGS_REPEAT_ALERT_SECONDS=1800
NVGS_BATTERY_WARNING_PERCENT=30
NVGS_AUTH_DEDUPE_SECONDS=60

# The Ubuntu installer fills in the local desktop account. Warnings and
# recoveries appear as desktop notifications while that user is signed in.
NVGS_DESKTOP_NOTIFICATIONS=true
NVGS_DESKTOP_USER=ubuntu-user
NVGS_FULLSCREEN_ALERTS=true

# Leave blank to record alerts only in the local system journal. Insert an
# approved webhook URL to also send alerts remotely.
NVGS_ALERT_WEBHOOK_URL=
